#!/bin/bash -p
# Fast pre-push gates on the files this branch changes. .githooks/pre-push
# hands off to this script after its signature walk. It runs the local halves
# of the CI checks that failed most often after a push: doc links, doc
# language, codespell, and PR shape. It reads the pre-push lines
# Git writes on stdin and gates each pushed branch in a detached checkout of
# the pushed commit, so working-tree edits and untracked files cannot change
# the result. The checkers come from this script's own tree, never from the
# pushed commit: a pushed ref is untrusted code, and this hook holds the host
# credentials. Generated artifacts are not checked here: that check runs the
# commit's own generators, so CI's validate job and the pre-merge gate own it.
# The detached checkout runs with hooks disabled, so no pushed hook runs either.
# Set WORKCELL_SKIP_PREPUSH_CHECKS=1 only for an intentional bypass.
#
# Language boundary: the doc gates read every tracked Markdown file, and
# codespell follows links, so a committed symlink could make them print a host
# file. The hook refuses any path whose mode is 120000 anywhere in the pushed
# tree. It does not test the disk: git builds the checkout from that tree in a
# private mktemp -d directory, with every host filter driver emptied so no
# pushed .gitattributes can run a smudge command; the tree is the source of
# truth. The native
# checkers (awk and grep in check-doc-links.sh, workcell-citools, codespell)
# then open the files by path. Bash has no descriptor-relative no-follow open.
# A process that swaps a link into that private checkout is same-user malware
# (docs/threat-model.md, Exclusions).
workcell_entry_root="$(shopt -s nullglob && f="${BASH_SOURCE[0]}" r=scripts/githooks/pre-push && y=/usr/bin/find && { [[ -x "${y}" ]] || y=/bin/find; } && i=/usr/bin/id && { [[ -x "${i}" ]] || i=/bin/id; } && l=/bin/ls && { [[ -x "${l}" ]] || l=/usr/bin/ls; } && e=/usr/bin/getent && { [[ -x "${e}" ]] || e=/bin/getent; } && { [[ "${f}" == /* ]] || f="${PWD}/${f}"; } && cd -P -- "${f%/*}/" && d="${PWD}" && p="${d%/}/${f##*/}" && root="${p%/"${r}"}" && [[ -n "${root}" && "${root}/${r}" == "${p}" ]] && set -- "${p}" && f="${f%/*}" && while ((${#d} >= ${#root})); do cd -L -- "${f}/" && cd -P . && [[ "${PWD}" == "${d}" ]] && set -- "$@" "${d}" && d="${d%/*}" f="${f}/.." || exit 1; done && for h in scripts scripts/ci scripts/ci/lib scripts/lib scripts/lib/launcher runtime/container; do [[ ! -e "${root}/${h}" && ! -L "${root}/${h}" ]] || set -- "$@" "${root}/${h}" "${root}/${h}"/*; done && q="${root%/*}" && a=(/) && while [[ -n "${q}" ]]; do a+=("${q}") && q="${q%/*}"; done && { u="$(LC_ALL=C "${i}")" || u=""; } && g=(-perm -020) && { [[ "${u}" =~ ^uid=[0-9]+\(([^\)]+)\)\ gid=([0-9]+)\( ]] && n="${BASH_REMATCH[1]}" k="${BASH_REMATCH[2]}" && w="$(LC_ALL=C "${e}" group "${k}")" && [[ "${w}" == "${n}:"*":${k}:" ]] && j=$'\n' && o="${j}$(LC_ALL=C "${e}" passwd)" && o="${o//"${j}${n}:"/${j}#:#:#:#:}" && x=$'\n[^:\n]*:[^:\n]*:[^:\n]*:'"${k}:" && [[ ! "${o}" =~ ${x} ]] && g+=(! -gid "${k}") || :; } && { [[ "${OSTYPE}" != darwin* ]] || g+=(! -gid 80); } && bad="$("${y}" "$@" -maxdepth 0 \( ! -type d ! -type f -o ! -uid "${EUID}" ! -uid 0 -o "${g[@]}" -o -perm -002 \) -print)" && [[ -z "${bad}" ]] && bad="$("${y}" "${a[@]}" -maxdepth 0 \( ! -type d -o ! -uid "${EUID}" ! -uid 0 -o \( "${g[@]}" -o -perm -002 \) ! -perm -1000 \) -print)" && [[ -z "${bad}" ]] && if [[ "${OSTYPE}" == darwin* ]]; then z="$(LC_ALL=C "${l}" -lde -- "$@" "${a[@]}")" && x=$' allow ([^\n]*,)?(write|append|add_file|add_subdirectory|delete|delete_child|writeattr|writeextattr|writesecurity|chown)(,|\n|$)' && [[ ! "${z}" =~ ${x} ]]; else z="$(LC_ALL=C "${l}" -ld -- "$@" "${a[@]}")" && [[ $'\n'"${z}" != *$'\n'?????w????+* ]]; fi && printf '%s\n' "${root}")" || workcell_entry_root="" # fail-closed: an empty root stops the script below
[[ -n "${workcell_entry_root}" ]] || {
  echo "Run ${BASH_SOURCE[0]} from its own place in a Workcell tree that no other user can write, not through a symlink or a copy: it loads helpers from that tree. A filesystem without Unix permissions, such as WSL /mnt/c or exFAT, cannot hold such a tree." >&2
  exit 2
}
set -euo pipefail

if [[ "${WORKCELL_SKIP_PREPUSH_CHECKS:-0}" == "1" ]]; then
  exit 0
fi

ROOT_DIR="${workcell_entry_root}"
SCRIPTS="${ROOT_DIR}/scripts"
BASE_REF="${WORKCELL_PREPUSH_BASE_REF:-origin/main}"
cd "${ROOT_DIR}"

pushed_oids=()
while read -r _ local_oid remote_ref _; do
  # Deletes and tag pushes carry no branch content to gate.
  [[ "${remote_ref}" == refs/heads/* && ! "${local_oid}" =~ ^0+$ ]] || continue
  pushed_oids+=("${local_oid}")
done
[[ "${#pushed_oids[@]}" -gt 0 ]] || exit 0

if ! git rev-parse --verify --quiet "${BASE_REF}^{commit}" >/dev/null; then
  echo "pre-push: base ref ${BASE_REF} is missing; run git fetch origin main." >&2
  exit 1
fi

# CONTRIBUTING.md promises this hook works without Go; doc language and the
# doc-claims probe in the link check need it.
have_go=0
if command -v go >/dev/null; then
  have_go=1
else
  echo "pre-push: go is missing; skipping the doc language gate." >&2
fi

checkout=""
changed_list="$(mktemp "${TMPDIR:-/tmp}/workcell-prepush.XXXXXX")"
cleanup() {
  rm -f "${changed_list}"
  if [[ -n "${checkout}" ]]; then
    if ! git -C "${ROOT_DIR}" worktree remove --force "${checkout}"; then
      rm -rf "${checkout}"
    fi
  fi
}
trap cleanup EXIT

failures=0
run_gate() {
  local name="$1"
  shift
  echo "[pre-push] ${name}"
  if ! "$@"; then
    echo "pre-push: ${name} failed" >&2
    failures=$((failures + 1))
  fi
}

gate_commit() {
  local oid="$1" merge_base file
  checkout="$(mktemp -d "${TMPDIR:-/tmp}/workcell-prepush-tree.XXXXXX")"
  # A plain worktree add runs post-checkout, and core.hooksPath can point into
  # the pushed tree. Add the worktree empty, then check out with hooks disabled.
  # A pushed .gitattributes can also select a smudge filter from the host Git
  # config, so every configured filter driver is emptied for the checkout. A
  # sparse checkout on the host would hide pushed files from the gates, so the
  # detached tree is always complete.
  local drivers driver no_filters=()
  # git config exits 1 when no key matches; any other failure stops the push.
  drivers="$(git -C "${ROOT_DIR}" config --get-regexp '^filter\.')" || [[ $? -eq 1 ]] || exit 1
  while IFS= read -r driver; do
    [[ -n "${driver}" ]] || continue
    driver="${driver%% *}"
    driver="${driver#filter.}"
    driver="${driver%.*}"
    no_filters+=(-c "filter.${driver}.smudge=" -c "filter.${driver}.process=" -c "filter.${driver}.required=false")
  done <<<"${drivers}"
  local unreadable="pre-push: cannot check out ${oid} for the gates; set WORKCELL_SKIP_PREPUSH_CHECKS=1 to bypass."
  if ! git -C "${ROOT_DIR}" worktree add --quiet --no-checkout --detach "${checkout}" "${oid}"; then
    echo "${unreadable}" >&2
    exit 1
  fi
  if ! git -C "${checkout}" -c core.hooksPath=/dev/null -c core.fsmonitor=false -c core.sparseCheckout=false ${no_filters[@]+"${no_filters[@]}"} checkout --quiet --detach "${oid}"; then
    echo "${unreadable}" >&2
    exit 1
  fi
  cd "${checkout}"
  merge_base="$(git merge-base "${BASE_REF}" HEAD)" || exit 1
  # Without rename detection a renamed or deleted .md lists its old path.
  git diff -z --no-renames --name-only "${merge_base}" HEAD >"${changed_list}"

  # Symlink-ness comes from the pushed tree, not the disk; see the header. The
  # gates read every tracked Markdown file, so the whole tree is scanned, not
  # only the changed paths: a link that main already holds is followed too.
  local links="" link
  links="$(git ls-tree -r -z "${oid}" | tr '\0' '\n' | awk -F'\t' '/^120000 / { print $2 }')" || exit 1

  local changed_files=() markdown_changed=0 target_removed=0 symlinked=0
  if [[ -n "${links}" ]]; then
    while IFS= read -r link; do
      echo "pre-push: ${link} is a symlink in ${oid}; the gates must not follow it into the host." >&2
    done <<<"${links}"
    symlinked=1
  fi
  while IFS= read -r -d '' file; do
    # A deleted .md can break a link, so it counts; codespell needs a file.
    [[ "${file}" != *.md ]] || markdown_changed=1
    if [[ -e "${file}" ]]; then
      changed_files+=("${file}")
    else
      # A Markdown link can name any file type, so any removal can break one.
      target_removed=1
    fi
  done <"${changed_list}"

  if [[ "${symlinked}" -eq 1 ]]; then
    echo "pre-push: skipping every gate for ${oid}; remove the symlink." >&2
    failures=$((failures + 1))
  else
    # Each checker takes the detached tree as its root and reads it as data.
    if [[ "${markdown_changed}" -eq 1 || "${target_removed}" -eq 1 ]]; then
      if [[ "${have_go}" -eq 1 ]]; then
        run_gate "doc links" "${SCRIPTS}/check-doc-links.sh" "${checkout}"
      else
        run_gate "doc links" env DOC_CLAIMS_SKIP=1 "${SCRIPTS}/check-doc-links.sh" "${checkout}"
      fi
    fi
    if [[ "${markdown_changed}" -eq 1 && "${have_go}" -eq 1 ]]; then
      run_gate "doc language" "${SCRIPTS}/check-doc-language.sh" "${checkout}"
    fi
    if [[ "${#changed_files[@]}" -gt 0 ]]; then
      if command -v codespell >/dev/null; then
        run_gate "codespell" "${SCRIPTS}/ci/run-codespell.sh" "${checkout}" "${changed_files[@]}"
      else
        echo "pre-push: codespell is missing; run ./scripts/install-dev-tools.sh." >&2
        failures=$((failures + 1))
      fi
    fi
    run_gate "PR shape" "${SCRIPTS}/check-pr-shape.sh" --repo-root "${checkout}" --base-ref "${BASE_REF}"
  fi

  cd "${ROOT_DIR}"
  git worktree remove --force "${checkout}"
  checkout=""
}

for oid in "${pushed_oids[@]}"; do
  gate_commit "${oid}"
done

if [[ "${failures}" -ne 0 ]]; then
  echo "pre-push: ${failures} gate(s) failed; fix them or set WORKCELL_SKIP_PREPUSH_CHECKS=1 to bypass." >&2
  exit 1
fi
