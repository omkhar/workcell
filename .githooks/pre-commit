#!/bin/bash -p
readonly TRUSTED_HOST_PATH="/Applications/Codex.app/Contents/Resources:/opt/homebrew/bin:/usr/local/bin:/usr/local/go/bin:/usr/bin:/bin:/opt/homebrew/sbin:/usr/local/sbin:/usr/sbin:/sbin:/Applications/Docker.app/Contents/Resources/bin"
if [[ "${WORKCELL_PRECOMMIT_SANITIZED_ENTRYPOINT:-0}" != "1" ]]; then
  exec /usr/bin/env -i \
    PATH="${TRUSTED_HOST_PATH}" \
    HOME="${HOME:-/tmp}" \
    TMPDIR="${TMPDIR:-/tmp}" \
    WORKCELL_SKIP_UPSTREAM_REFRESH_PRECOMMIT="${WORKCELL_SKIP_UPSTREAM_REFRESH_PRECOMMIT:-}" \
    WORKCELL_SKIP_PROVIDER_BUMP_PRECOMMIT="${WORKCELL_SKIP_PROVIDER_BUMP_PRECOMMIT:-}" \
    WORKCELL_PRECOMMIT_SANITIZED_ENTRYPOINT=1 \
    /bin/bash -p "$0" "$@"
fi
set -euo pipefail
export PATH="${TRUSTED_HOST_PATH}"

if [[ "${WORKCELL_SKIP_UPSTREAM_REFRESH_PRECOMMIT:-${WORKCELL_SKIP_PROVIDER_BUMP_PRECOMMIT:-0}}" == "1" ]]; then
  exit 0
fi

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${HOOK_DIR}/.." && pwd)"

if output="$("${ROOT_DIR}/scripts/update-upstream-pins.sh" --check 2>&1)"; then
  exit 0
else
  status=$?
fi

# The hook reports and never blocks. The upstream-refresh workflow opens the
# bump PRs, and CI pin hygiene and the release preflight fail on stale pins.
# Blocking every local commit on each daily pin (for example the Debian
# snapshot date) added no protection (issue 894).
printf '%s\n' "${output}" >&2
if grep -q 'GitHub API rate limit reached' <<<"${output}"; then
  # The check could not run, so no pin is known to be pending.
  echo "The pinned upstream check hit the GitHub API rate limit, so it did not run." >&2
  # The hook runs the worktree pin script, so it passes no GitHub credential.
  echo "Retry after the reset that the message above names." >&2
elif [[ "${status}" -eq 1 ]]; then
  echo "Pinned upstream updates are available; the commit continues." >&2
  echo "The upstream-refresh workflow opens their bump PRs. To refresh now, run ./scripts/update-upstream-pins.sh --apply from a clean worktree." >&2
else
  echo "The pinned upstream check failed with status ${status}; the commit continues." >&2
fi
exit 0
