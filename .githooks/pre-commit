#!/bin/bash -p
workcell_entry_root="$(shopt -s nullglob && f="${BASH_SOURCE[0]}" r=.githooks/pre-commit && y=/usr/bin/find && { [[ -x "${y}" ]] || y=/bin/find; } && i=/usr/bin/id && { [[ -x "${i}" ]] || i=/bin/id; } && l=/bin/ls && { [[ -x "${l}" ]] || l=/usr/bin/ls; } && e=/usr/bin/getent && { [[ -x "${e}" ]] || e=/bin/getent; } && { [[ "${f}" == /* ]] || f="${PWD}/${f}"; } && cd -P -- "${f%/*}/" && d="${PWD}" && p="${d%/}/${f##*/}" && root="${p%/"${r}"}" && [[ -n "${root}" && "${root}/${r}" == "${p}" ]] && set -- "${p}" && f="${f%/*}" && while ((${#d} >= ${#root})); do cd -L -- "${f}/" && cd -P . && [[ "${PWD}" == "${d}" ]] && set -- "$@" "${d}" && d="${d%/*}" f="${f}/.." || exit 1; done && for h in scripts scripts/ci scripts/ci/lib scripts/lib scripts/lib/launcher runtime/container; do [[ ! -e "${root}/${h}" && ! -L "${root}/${h}" ]] || set -- "$@" "${root}/${h}" "${root}/${h}"/*; done && q="${root%/*}" && a=(/) && while [[ -n "${q}" ]]; do a+=("${q}") && q="${q%/*}"; done && { u="$(LC_ALL=C "${i}")" || u=""; } && g=(-perm -020) && { [[ "${u}" =~ ^uid=[0-9]+\(([^\)]+)\)\ gid=([0-9]+)\( ]] && n="${BASH_REMATCH[1]}" k="${BASH_REMATCH[2]}" && w="$(LC_ALL=C "${e}" group "${k}")" && [[ "${w}" == "${n}:"*":${k}:" ]] && j=$'\n' && o="${j}$(LC_ALL=C "${e}" passwd)" && o="${o//"${j}${n}:"/${j}#:#:#:#:}" && x=$'\n[^:\n]*:[^:\n]*:[^:\n]*:'"${k}:" && [[ ! "${o}" =~ ${x} ]] && g+=(! -gid "${k}") || :; } && { [[ "${OSTYPE}" != darwin* ]] || g+=(! -gid 80); } && bad="$("${y}" "$@" -maxdepth 0 \( ! -type d ! -type f -o ! -uid "${EUID}" ! -uid 0 -o "${g[@]}" -o -perm -002 \) -print)" && [[ -z "${bad}" ]] && bad="$("${y}" "${a[@]}" -maxdepth 0 \( ! -type d -o ! -uid "${EUID}" ! -uid 0 -o \( "${g[@]}" -o -perm -002 \) ! -perm -1000 \) -print)" && [[ -z "${bad}" ]] && if [[ "${OSTYPE}" == darwin* ]]; then z="$(LC_ALL=C "${l}" -lde -- "$@" "${a[@]}")" && x=$' allow ([^\n]*,)?(write|append|add_file|add_subdirectory|delete|delete_child|writeattr|writeextattr|writesecurity|chown)(,|\n|$)' && [[ ! "${z}" =~ ${x} ]]; else z="$(LC_ALL=C "${l}" -ld -- "$@" "${a[@]}")" && [[ $'\n'"${z}" != *$'\n'?????w????+* ]]; fi && printf '%s\n' "${root}")" || workcell_entry_root="" # fail-closed: an empty root stops the script below
[[ -n "${workcell_entry_root}" ]] || {
  echo "Run ${BASH_SOURCE[0]} from its own place in a Workcell tree that no other user can write, not through a symlink or a copy: it loads helpers from that tree. A filesystem without Unix permissions, such as WSL /mnt/c or exFAT, cannot hold such a tree." >&2
  exit 2
}
readonly TRUSTED_HOST_PATH="/Applications/Codex.app/Contents/Resources:/opt/homebrew/bin:/usr/local/bin:/usr/local/go/bin:/usr/bin:/bin:/opt/homebrew/sbin:/usr/local/sbin:/usr/sbin:/sbin:/Applications/Docker.app/Contents/Resources/bin"
if [[ "${WORKCELL_PRECOMMIT_SANITIZED_ENTRYPOINT:-0}" != "1" ]]; then
  exec /usr/bin/env -i \
    PATH="${TRUSTED_HOST_PATH}" \
    HOME="${HOME:-/tmp}" \
    TMPDIR="${TMPDIR:-/tmp}" \
    WORKCELL_SKIP_UPSTREAM_REFRESH_PRECOMMIT="${WORKCELL_SKIP_UPSTREAM_REFRESH_PRECOMMIT:-}" \
    WORKCELL_SKIP_PROVIDER_BUMP_PRECOMMIT="${WORKCELL_SKIP_PROVIDER_BUMP_PRECOMMIT:-}" \
    WORKCELL_PRECOMMIT_SANITIZED_ENTRYPOINT=1 \
    /bin/bash -p "${workcell_entry_root}/.githooks/pre-commit" "$@"
fi
set -euo pipefail
export PATH="${TRUSTED_HOST_PATH}"

if [[ "${WORKCELL_SKIP_UPSTREAM_REFRESH_PRECOMMIT:-${WORKCELL_SKIP_PROVIDER_BUMP_PRECOMMIT:-0}}" == "1" ]]; then
  exit 0
fi

HOOK_DIR="${workcell_entry_root}/.githooks"
ROOT_DIR="$(cd "${HOOK_DIR}/.." && pwd)"

if output="$("${ROOT_DIR}/scripts/update-upstream-pins.sh" --check 2>&1)"; then
  exit 0
else
  status=$?
fi

# The hook reports and never blocks. The upstream-refresh workflow opens the
# bump PRs, and CI pin hygiene and the release preflight fail on stale pins.
# Blocking every local commit on each daily pin (for example the Debian
# snapshot date) added no protection (issue 894).
printf '%s\n' "${output}" >&2
if grep -q 'GitHub API rate limit reached' <<<"${output}"; then
  # The check could not run, so no pin is known to be pending.
  echo "The pinned upstream check hit the GitHub API rate limit, so it did not run." >&2
  # The hook runs the worktree pin script, so it passes no GitHub credential.
  echo "Retry after the reset that the message above names." >&2
elif [[ "${status}" -eq 1 ]]; then
  echo "Pinned upstream updates are available; the commit continues." >&2
  echo "The upstream-refresh workflow opens their bump PRs. To refresh now, run ./scripts/update-upstream-pins.sh --apply from a clean worktree." >&2
else
  echo "The pinned upstream check failed with status ${status}; the commit continues." >&2
fi
exit 0
