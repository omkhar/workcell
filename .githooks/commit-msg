#!/bin/bash -p
readonly TRUSTED_HOST_PATH="/opt/homebrew/bin:/usr/local/bin:/usr/local/go/bin:/usr/bin:/bin:/opt/homebrew/sbin:/usr/local/sbin:/usr/sbin:/sbin"
if [[ "${WORKCELL_COMMITMSG_SANITIZED_ENTRYPOINT:-0}" != "1" ]]; then
  exec /usr/bin/env -i \
    PATH="${TRUSTED_HOST_PATH}" \
    HOME="${HOME:-/tmp}" \
    TMPDIR="${TMPDIR:-/tmp}" \
    GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:-}" \
    WORKCELL_SKIP_COMMIT_NOTATION="${WORKCELL_SKIP_COMMIT_NOTATION:-}" \
    WORKCELL_COMMITMSG_SANITIZED_ENTRYPOINT=1 \
    /bin/bash -p "$0" "$@"
fi
set -euo pipefail
export PATH="${TRUSTED_HOST_PATH}"

if [[ "${WORKCELL_SKIP_COMMIT_NOTATION:-0}" == "1" ]]; then
  exit 0
fi

message_file="${1:-}"
if [[ -z "${message_file}" || ! -f "${message_file}" ]]; then
  echo "commit-msg hook requires the commit message file argument." >&2
  exit 2
fi

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${HOOK_DIR}/.." && pwd)"

notation_ok() {
  case "$1" in
    "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*)
      return 0
      ;;
  esac
  [[ "$1" =~ ^[.^!@][FfBbRrDd]\ .+\ \(.+\;\ .+\)$ ]]
}

# GIT_CONFIG_PARAMETERS carries the outer `git -c name=value` settings, so
# stripspace here resolves the same comment character the outer command will.
# It is forwarded rather than scrubbed because the person running that command
# already controls both the message and the documented bypass variable.
#
# Check the subject Git would retain first. A repository can configure
# core.commentChar to a risk symbol such as ^, and comment stripping would
# then delete a valid subject.
retained="$(git -C "${ROOT_DIR}" stripspace <"${message_file}" || true)"
if notation_ok "${retained%%$'\n'*}"; then
  exit 0
fi

# Otherwise fall back to the comment-stripped view. stripspace honours
# core.commentChar, so a configured comment character is handled here too.
body="$(git -C "${ROOT_DIR}" stripspace --strip-comments <"${message_file}" || true)"
subject="${body%%$'\n'*}"

if notation_ok "${subject}"; then
  # Git only strips comments for editor-cleaned messages, so -m and -F keep
  # them. Drop just the comment lines ahead of the subject, so Git retains the
  # subject that was checked and the body keeps every line as written.
  # ENVIRON, not -v: awk applies escape processing to a -v assignment, so a
  # backslash in the subject would stop it matching its own line.
  trimmed="$(SUBJECT="${subject}" awk 'found || $0 == ENVIRON["SUBJECT"] { found = 1; print }' "${message_file}")"
  printf '%s\n' "${trimmed}" >"${message_file}"
  exit 0
fi

echo "Commit subject does not follow Risk-Aware Commit Notation." >&2
echo "Required format: <risk><intent> <description> (risk reason; case reason)" >&2
echo "Risk symbols: . ^ ! @  Intent letters: F B R D (or lowercase)." >&2
echo "See .claude/skills/commit/SKILL.md for the full rules." >&2
echo "Set WORKCELL_SKIP_COMMIT_NOTATION=1 only for an intentional bypass." >&2
exit 1
